<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>car_museum_guide</name>
  <version>2.0.0</version>
  <description>Car museum guide robot for TurtleBot4 with AI-powered descriptions, Q&amp;A, wake word, and visitor detection (ROS2 Jazzy)</description>
  <maintainer email="firasbf6@gmail.com">firas</maintainer>
  <license>Apache-2.0</license>

  <!-- Changed from ament_cmake to ament_python -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- ROS2 Jazzy dependencies -->
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>

  <!-- Python dependencies (install via pip) -->
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>