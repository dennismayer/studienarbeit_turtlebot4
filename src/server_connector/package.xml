<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>server_connector</name>
  <version>0.0.0</version>
  <description>Gateway node that holds the connection to the external server for all other nodes</description>
  <maintainer email="dennis.mayer1204@gmail.com">Dennis Mayer</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>server_interfaces</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_common</exec_depend>
  <exec_depend>python3-requests</exec_depend>
  <exec_depend>python3-dotenv</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
